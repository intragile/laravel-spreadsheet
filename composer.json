{
    "name": "intragile/laravel-spreadsheet",
    "description": "Streaming spreadsheet export and guided import for Laravel, built on intragile/php-spreadsheet: constant memory, keyset pagination, column mapping, validation and duplicate detection.",
    "keywords": [
        "laravel",
        "spreadsheet",
        "xlsx",
        "csv",
        "export",
        "import",
        "streaming",
        "eloquent"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://intragile.eu",
    "support": {
        "issues": "https://github.com/intragile/laravel-spreadsheet/issues",
        "source": "https://github.com/intragile/laravel-spreadsheet",
        "security": "https://github.com/intragile/laravel-spreadsheet/security/policy"
    },
    "authors": [
        {
            "name": "IntrAgile Kft.",
            "email": "info@intragile.eu",
            "homepage": "https://intragile.eu"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../php-spreadsheet",
            "options": {
                "symlink": true,
                "versions": {
                    "intragile/php-spreadsheet": "1.0.0"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-pdo_sqlite": "*",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "intragile/php-spreadsheet": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "ext-intl": "Needed for IDN domains and localized country and language names."
    },
    "conflict": {
        "illuminate/support": "<12.0"
    },
    "autoload": {
        "psr-4": {
            "IntrAgile\\LaravelSpreadsheet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IntrAgile\\LaravelSpreadsheet\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IntrAgile\\LaravelSpreadsheet\\SpreadsheetServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
